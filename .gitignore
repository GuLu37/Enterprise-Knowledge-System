# ==================== 安全/代理工具状态目录 ====================
.mimosa/
.workbuddy/
.zcode/

# ==================== IDE / 编辑器 ====================
.idea/
.vscode/

# ==================== Python 缓存（根目录级） ====================
__pycache__/
*.py[cod]
.pytest_cache/

# ==================== Rust 构建产物 ====================
backend/native/*/target/
backend/native/*/dist/

# ==================== 基准/评估产物 ====================
