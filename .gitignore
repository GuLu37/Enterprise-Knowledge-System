docs/rrf_*.json
!docs/rrf_ablation_eval.json
docs/rrf_*.log
backend/bench_*.txt
backend/bench_results/

# ==================== 本地临时文件 ====================
*.tmp
*.bak
.DS_Store

# ==================== Rust 构建产物 ====================
backend-rs/target/
