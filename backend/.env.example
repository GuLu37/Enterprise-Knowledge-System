# =====================================================
# Enterprise Knowledge System - 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# =====================================================

# ==================== 应用基础配置 ====================
APP_NAME=Enterprise Knowledge System
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=开发版
LOG_LEVEL=INFO

# ==================== 服务器配置 ====================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# ==================== LLM 配置 ====================
# 默认 LLM 提供商
LLM_PROVIDER=ollama

# Ollama 配置 (本地模型)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# OpenAI 配置 (可选)
# OPENAI_API_KEY=sk-xxxxx
OPENAI_MODEL=gpt-5.5
# OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek 配置 (可选，从 https://platform.deepseek.com 获取)
# DEEPSEEK_API_KEY=sk-xxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 第三方/中转站LLM配置 (可选)
# OPENROUTER_API_KEY=sk-xxxxx
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=your-model-name

# Anthropic 配置 (可选)
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-6

# LLM 通用参数
# 温度: 0=确定性最强(代码/数据抽取), 1=默认平衡, 2=最有创意
LLM_TEMPERATURE=0.7
# 最大输出TOKENS数量
LLM_MAX_TOKENS=2000
# LLM请求超时时间(秒)
LLM_TIMEOUT=60

# ==================== 向量化配置 ====================
EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSION=768

# BGE 本地向量化配置
BGE_MODEL_NAME=BAAI/bge-base-zh-v1.5
BGE_DEVICE=auto
BGE_MAX_LENGTH=512
BGE_BATCH_SIZE=16
BGE_NORMALIZE_EMBEDDINGS=true
BGE_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
BGE_CACHE_DIR=
BGE_LOCAL_FILES_ONLY=false

# ==================== 向量数据库配置 ====================
# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DB_NAME=rag_db
# 文档切块 collection
MILVUS_DOC_COLLECTION_NAME=doc_chunks
# 对话长期记忆 collection
MILVUS_MEMORY_COLLECTION_NAME=memory_chunks

# 向量库参数
VECTOR_STORE_TYPE=milvus
SEARCH_TOP_K=5
SIMILARITY_THRESHOLD=0.5

# ==================== 元数据数据库配置 ====================
# SQLite 配置 (开发环境)
DATABASE_URL=sqlite:///./rag_metadata.db
# PostgreSQL 配置 (生产环境，可选)
# DATABASE_URL=postgresql://user:password@localhost:5432/rag_db

# ==================== 文件存储配置 ====================
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=104857600
ALLOWED_FILE_TYPES=["pdf", "txt", "md", "doc", "docx", "ppt", "pptx", "xlsx", "xls"]

# ==================== 检索配置 ====================
USE_DENSE_RETRIEVER=true
USE_SPARSE_RETRIEVER=true
USE_HYBRID_RETRIEVER=true
DENSE_WEIGHT=0.6
SPARSE_WEIGHT=0.4

# ==================== 缓存配置 ====================
ENABLE_CACHE=true
CACHE_DIR=./data/cache
CACHE_TTL=3600

# ==================== 日志配置 ====================
LOG_DIR=./logs
LOG_FILE_NAME=app.log

# ==================== Langsmith监控配置 (可选) ====================
# 从 https://smith.langchain.com 获取
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=lsv2_pt_xxxxx
# LANGSMITH_PROJECT=Enterprise Knowledge System
