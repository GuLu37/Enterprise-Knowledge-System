# =====================================================
# Enterprise Knowledge System - backend/.env.example
# 复制为 backend/.env 后再启动后端或 docker compose
# =====================================================

# ==================== 应用基础配置 ====================
APP_NAME=Enterprise Knowledge System
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=开发版
LOG_LEVEL=INFO

# ==================== 服务器配置 ====================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
API_PREFIX=/api/v1
# 生产环境把实际前端域名加入这里；同域部署可保留相对路径
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8080", "https://your-domain.com"]

# ==================== LLM 配置 ====================
# 默认提供商：ollama / openai / deepseek / openrouter / anthropic
LLM_PROVIDER=deepseek

# Ollama（本地模型）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral

# OpenAI（可选）
# OPENAI_API_KEY=sk-xxxxx
# OPENAI_MODEL=gpt-5.5
# OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek（可选）
# DEEPSEEK_API_KEY=sk-xxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# OpenRouter（可选）
# OPENROUTER_API_KEY=sk-xxxxx
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=your-model-name

# Anthropic（可选）
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ==================== LLM 通用参数 ====================
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60
# 单次请求最多尝试的模型提供商数量，包含首次调用
LLM_MAX_FALLBACK_ATTEMPTS=2

# ==================== 聊天配置 ====================
CHAT_MAX_CONVERSATIONS=20
MEMORY_CLEANUP_INTERVAL_SECONDS=3600
MEMORY_EVENT_EXPIRY_DAYS=90
MEMORY_PROFILE_STALE_DAYS=180
MEMORY_SCORE_THRESHOLD=20
MEMORY_PURGE_RETENTION_DAYS=30

# ==================== 认证配置 ====================
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=60
# 用户每次有效交互后，登录会话重新延长的空闲时长（分钟）
SESSION_IDLE_TIMEOUT_MINUTES=60
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=123456
BOOTSTRAP_ADMIN_ROLE=admin

# ==================== 向量化配置 ====================
EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSION=768

# BGE 本地向量化
BGE_MODEL_NAME=./app/models/bge-base-zh-v1.5
BGE_DEVICE=auto
BGE_MAX_LENGTH=512
BGE_BATCH_SIZE=16
BGE_NORMALIZE_EMBEDDINGS=true
BGE_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
BGE_CACHE_DIR=./app/models
BGE_LOCAL_FILES_ONLY=false
# BGE 推理内核: auto=优先 Rust ONNX 缺产物回退 torch; rust; torch
EMBEDDING_KERNEL=auto

# ==================== 向量数据库配置 ====================
# 向量库模式：milvus / milvus_lite
VECTOR_STORE_TYPE=milvus

# 服务端 Milvus 配置（仅 VECTOR_STORE_TYPE=milvus 时使用）
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DB_NAME=rag_db

# Milvus Lite 本地文件路径（仅 VECTOR_STORE_TYPE=milvus_lite 时使用）
MILVUS_LITE_PATH=./data/milvus_lite.db

MILVUS_DOC_COLLECTION_NAME=doc_chunk
MILVUS_CHILD_COLLECTION_NAME=doc_chunk
MILVUS_MEMORY_COLLECTION_NAME=memory_chunks
SEARCH_TOP_K=5
SIMILARITY_THRESHOLD=0.5

# ==================== 元数据数据库配置 ====================
# SQLite 默认固定在 backend/app/data/rag_metadata.db
DATABASE_URL=sqlite:///./app/data/rag_metadata.db
# MySQL 示例：
# DATABASE_URL=mysql+pymysql://user:password@mysql:3306/rag_db?charset=utf8mb4
# PostgreSQL 示例：
# DATABASE_URL=postgresql://user:password@localhost:5432/rag_db

# ==================== 文件存储配置 ====================
# 上传文件固定落在 backend/app/data/uploads
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=104857600
ALLOWED_FILE_TYPES=["pdf", "txt", "md", "doc", "docx", "ppt", "pptx", "xlsx", "xls"]

# ==================== 检索配置 ====================
USE_DENSE_RETRIEVER=true
USE_SPARSE_RETRIEVER=true
USE_HYBRID_RETRIEVER=true
DENSE_WEIGHT=0.5
SPARSE_WEIGHT=0.5

# ==================== 重排配置 ====================
# 规则先宽排，Cross-Encoder 再精排前 N 个候选；默认关闭，避免未准备模型时影响基础检索。
CROSS_ENCODER_ENABLED=false
CROSS_ENCODER_MODEL_NAME=BAAI/bge-reranker-base
CROSS_ENCODER_DEVICE=auto
CROSS_ENCODER_MAX_LENGTH=512
CROSS_ENCODER_BATCH_SIZE=8
CROSS_ENCODER_CACHE_DIR=./app/models
CROSS_ENCODER_LOCAL_FILES_ONLY=false
CROSS_ENCODER_CANDIDATE_K=30
CROSS_ENCODER_WEIGHT=0.65
RULE_RERANK_WEIGHT=0.35
# 精排触发模式: adaptive=规则高置信跳过精排（默认）; always=始终精排; off=关闭精排
CROSS_ENCODER_TRIGGER_MODE=adaptive
# adaptive 模式阈值: top-1 置信分与领先幅度均达标才跳过精排
CROSS_ENCODER_CONFIDENCE_THRESHOLD=0.60
CROSS_ENCODER_CONFIDENCE_MARGIN=0.08

# ==================== 缓存配置 ====================
ENABLE_CACHE=true
CACHE_DIR=./data/cache
CACHE_TTL=3600

# ==================== MCP / Skill 适配配置 ====================
# 远程 MCP 工具清单会自动转成 Skill 暴露给 agent；为空时表示暂不接入远程工具。
MCP_REMOTE_TOOL_MANIFESTS=[]

# ==================== 日志配置 ====================
LOG_DIR=./logs

# ==================== LangSmith 配置（可选）====================
LANGSMITH_TRACING=false
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=lsv2_pt_xxxxx
# LANGSMITH_PROJECT=Enterprise Knowledge System

# 稀疏检索候选来源: cached=进程内持久索引(默认) / legacy=LIKE+重建BM25
SPARSE_INDEX_MODE=cached
SPARSE_INDEX_MAX_ROWS=50000
