# =====================================================
# RAG 三重检索系统 - 环境变量配置
# =====================================================

# ==================== 应用基础配置 ====================
APP_NAME=LangChain RAG Tutorial
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==================== 服务器配置 ====================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# ==================== LLM 配置 ====================
# Ollama 配置 (本地模型)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# OpenAI 配置 (可选)
# OPENAI_API_KEY=sk-xxxxx
# OPENAI_MODEL=gpt-3.5-turbo
# OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek 配置 (可选)
# DEEPSEEK_API_KEY=xxxxx

# Anthropic 配置 (可选)
# ANTHROPIC_API_KEY=xxxxx

# LLM 通用参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60

# ==================== 向量化配置 ====================
# Ollama Embedding 配置
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_DIMENSION=768

# ==================== 向量数据库配置 ====================
# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DB_NAME=rag_db
MILVUS_COLLECTION_NAME=documents

# 向量库参数
VECTOR_STORE_TYPE=milvus
SEARCH_TOP_K=5
SIMILARITY_THRESHOLD=0.5

# ==================== 元数据数据库配置 ====================
# SQLite 配置 (开发环境)
DATABASE_URL=sqlite:///./rag_metadata.db

# PostgreSQL 配置 (生产环境，可选)
# DATABASE_URL=postgresql://user:password@localhost:5432/rag_db

# ==================== 文件存储配置 ====================
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=104857600
ALLOWED_FILE_TYPES=["pdf", "txt", "md", "doc", "docx", "ppt", "pptx", "xlsx", "xls"]

# ==================== 文本处理配置 ====================
CHUNK_SIZE=800
CHUNK_OVERLAP=200
TEXT_SPLITTER_TYPE=recursive

# ==================== 检索配置 ====================
USE_DENSE_RETRIEVER=true
USE_SPARSE_RETRIEVER=true
USE_HYBRID_RETRIEVER=true

DENSE_WEIGHT=0.6
SPARSE_WEIGHT=0.4

# ==================== 缓存配置 ====================
ENABLE_CACHE=true
CACHE_DIR=./data/cache
CACHE_TTL=3600

# ==================== 日志配置 ====================
LOG_DIR=./logs
LOG_FILE_NAME=app.log
