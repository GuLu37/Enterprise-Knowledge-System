# =====================================================
# Enterprise Knowledge System - backend/.env.example
# 复制为 backend/.env 后再启动后端或 docker compose
# =====================================================

# ==================== 应用基础配置 ====================
APP_NAME=Enterprise Knowledge System
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=开发版
LOG_LEVEL=INFO

# ==================== 服务器配置 ====================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
API_PREFIX=/api/v1
# 生产环境把实际前端域名加入这里；同域部署可保留相对路径
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8080", "https://your-domain.com"]

# ==================== LLM 配置 ====================
# 默认提供商：ollama / openai / deepseek / openrouter / anthropic
LLM_PROVIDER=ollama

# Ollama（本地模型）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral

# OpenAI（可选）
# OPENAI_API_KEY=sk-xxxxx
# OPENAI_MODEL=gpt-5.5
# OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek（可选）
# DEEPSEEK_API_KEY=sk-xxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# OpenRouter（可选）
# OPENROUTER_API_KEY=sk-xxxxx
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=your-model-name

# Anthropic（可选）
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ==================== LLM 通用参数 ====================
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60

# ==================== 聊天配置 ====================
CHAT_MAX_CONVERSATIONS=20

# ==================== 认证配置 ====================
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=30
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=123456
BOOTSTRAP_ADMIN_ROLE=admin

# ==================== 向量化配置 ====================
EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSION=768

# BGE 本地向量化
BGE_MODEL_NAME=./models/bge-base-zh-v1.5
BGE_DEVICE=auto
BGE_MAX_LENGTH=512
BGE_BATCH_SIZE=16
BGE_NORMALIZE_EMBEDDINGS=true
BGE_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
BGE_CACHE_DIR=./models
BGE_LOCAL_FILES_ONLY=false

# ==================== 向量数据库配置 ====================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DB_NAME=rag_db
MILVUS_DOC_COLLECTION_NAME=doc_chunks
MILVUS_MEMORY_COLLECTION_NAME=memory_chunks

VECTOR_STORE_TYPE=milvus
SEARCH_TOP_K=5
SIMILARITY_THRESHOLD=0.5

# ==================== 元数据数据库配置 ====================
# SQLite 默认固定在 backend/app/data/rag_metadata.db
DATABASE_URL=sqlite:///./app/data/rag_metadata.db
# MySQL 示例：
# DATABASE_URL=mysql+pymysql://user:password@mysql:3306/rag_db?charset=utf8mb4
# PostgreSQL 示例：
# DATABASE_URL=postgresql://user:password@localhost:5432/rag_db

# ==================== 文件存储配置 ====================
# 上传文件固定落在 backend/app/data/uploads
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=104857600
ALLOWED_FILE_TYPES=["pdf", "txt", "md", "doc", "docx", "ppt", "pptx", "xlsx", "xls"]

# ==================== 检索配置 ====================
USE_DENSE_RETRIEVER=true
USE_SPARSE_RETRIEVER=true
USE_HYBRID_RETRIEVER=true
DENSE_WEIGHT=0.6
SPARSE_WEIGHT=0.4

# ==================== 缓存配置 ====================
ENABLE_CACHE=true
CACHE_DIR=./data/cache
CACHE_TTL=3600

# ==================== 日志配置 ====================
LOG_DIR=./logs

# ==================== LangSmith 配置（可选）====================
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=lsv2_pt_xxxxx
# LANGSMITH_PROJECT=Enterprise Knowledge System
